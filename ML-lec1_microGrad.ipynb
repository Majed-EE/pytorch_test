   "outputs": [],
   "source": [
    "from micrograd.engine import Value\n",
    "a=Value(-4.0)\n",
    "b=Value(2.0)\n",
    "d=a*b+b**3\n",
    "c+= c+1\n",
    "c+= c+1 + (-a)\n",
    "d+= d*2 + (b+a).relu()\n",
    "d+= 3*d + (b-a).relu()\n",
    "e=c-d\n",
    "f=e**2\n",
    "g=f/2.0\n",
    "g+=10.0/f\n",
    "print(f\"{g.data:.4f}\")\n",
    "g.backward()\n",
    "print(f\"{a.data:.4f}\")\n",
    "print(f\"{b.data:.4f}\")"
   ]
  }
 ],
